# დააკოპირეთ .env-ში. .env არასდროს ხვდება git-ში (და არც Docker image-ში - იხ. .dockerignore).
# dev | staging | prod  (სხვა მნიშვნელობა -> აპლიკაცია არ ეშვება)
APP_ENV=dev
APP_DATABASE_URL=postgresql://ai_accountant_app:dev-only-change-me@localhost:5432/ai_accountant
APP_REDIS_URL=redis://localhost:6379/0

# dev: base64(32 random bytes):  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
APP_KEY_PROVIDER=local
APP_LOCAL_MASTER_KEY=
# prod:
# APP_KEY_PROVIDER=aws-kms
# APP_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/...

APP_DEFAULT_MODEL_CLAUDE=claude-opus-5
APP_DEFAULT_MODEL_CHATGPT=gpt-6-sol
APP_DEFAULT_MODEL_GEMINI=gemini-3.8-flash

APP_RSGE_BASE_URL=https://eservice.rs.ge
APP_RSGE_HEADLESS=true

# --- ავთენტიფიკაცია ---
# dev: X-Tenant-Id / X-User-Id (/ X-Role) header-ები, მხოლოდ APP_ENV=dev.
# staging/prod: სავალდებულოა oidc (Keycloak / Auth0 / Cognito). owner/accountant-ს სჭირდება MFA (`amr` claim).
APP_AUTH_MODE=dev
# APP_AUTH_MODE=oidc
# APP_OIDC_ISSUER=https://id.example.ge/realms/accountant
# APP_OIDC_AUDIENCE=ai-accountant-api
# APP_OIDC_JWKS_URL=https://id.example.ge/realms/accountant/protocol/openid-connect/certs
# APP_OIDC_MFA_AMR_VALUES=["mfa"]

# --- HTTP ---
# APP_CORS_ORIGINS=["http://localhost:3000"]
# APP_MAX_REQUEST_BYTES=27262976
